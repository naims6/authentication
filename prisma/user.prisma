model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  fullName          String
  isVerified        Boolean   @default(false)
  isBlocked         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sessions          Session[]
  otps              OTP[]
  
  @@index([email])
}

